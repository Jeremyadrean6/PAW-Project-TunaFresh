<%- include('partials/head', { title }) %>

<main class="max-w-6xl mx-auto px-5 py-8 space-y-7">
  <!-- Hero Banner -->
  <section class="bg-gradient-to-r from-deep to-ocean text-white rounded-3xl p-7 sm:p-8 shadow-sm">
    <p class="text-teal-200 text-xs sm:text-sm font-bold tracking-wider uppercase">TunaFresh</p>
    <h1 class="text-2xl sm:text-3xl font-extrabold mt-1.5">Manajemen Produk Ikan Tuna</h1>
    <p class="mt-2 text-sm sm:text-base text-slate-200 max-w-2xl">
      Kelola katalog produk ikan tuna melalui operasi CRUD PostgreSQL dan gunakan <b>TunaFresh AI Assistant</b> untuk menanyakan informasi stok, harga, maupun rekomendasi produk.
    </p>
  </section>

  <!-- Status Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
      <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Total Produk</p>
      <b id="total" class="text-3xl text-deep mt-1 block"><%= produk.length %></b>
    </div>
    <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
      <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Backend Server</p>
      <b id="backend" class="text-lg text-slate-600 mt-1 block">Memeriksa...</b>
    </div>
    <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
      <p class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Database PostgreSQL</p>
      <b id="database" class="text-lg text-slate-600 mt-1 block">Memeriksa...</b>
    </div>
  </div>

  <!-- TunaFresh AI Assistant -->
  <section id="ai-assistant" class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-100">
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-xl font-bold text-deep">TunaFresh AI Assistant</h2>
          <span class="bg-sky-50 text-ocean border border-sky-200 text-xs font-semibold px-2.5 py-0.5 rounded-full">Gemini AI</span>
        </div>
        <p class="text-sm text-slate-500 mt-0.5">Tanyakan ketersediaan produk, daftar harga, stok, atau saran pilihan produk.</p>
      </div>
      <button id="clearChat" type="button" class="self-start sm:self-auto text-xs font-medium text-slate-500 hover:text-ocean border border-slate-200 hover:border-ocean rounded-lg px-3 py-1.5 transition">
        Bersihkan Chat
      </button>
    </div>

    <!-- Area Percakapan -->
    <div id="chatMessages" class="bg-slate-50/70 border border-slate-200/80 rounded-xl p-4 h-72 overflow-y-auto space-y-3 my-4">
      <div class="flex items-start gap-2.5">
        <div class="w-7 h-7 rounded-full bg-ocean text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">AI</div>
        <div class="bg-white border border-slate-200 rounded-2xl rounded-tl-sm px-4 py-2.5 text-sm text-slate-700 shadow-sm max-w-[85%]">
          Halo! Saya <b>TunaFresh AI Assistant</b>. Silakan tanyakan informasi seputar produk ikan tuna segar maupun olahan yang tersedia di aplikasi ini.
        </div>
      </div>
    </div>

    <!-- Pertanyaan Cepat -->
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="text-xs text-slate-400">Contoh:</span>
      <button type="button" data-prompt="Apa saja produk yang tersedia di aplikasi ini?" class="quick-prompt text-xs bg-slate-100 hover:bg-sky-50 text-slate-700 hover:text-ocean border border-slate-200 rounded-full px-3 py-1 transition">
        Apa saja produk yang tersedia?
      </button>
      <button type="button" data-prompt="Produk apa saja yang termasuk kategori Ikan Segar beserta harganya?" class="quick-prompt text-xs bg-slate-100 hover:bg-sky-50 text-slate-700 hover:text-ocean border border-slate-200 rounded-full px-3 py-1 transition">
        Harga Ikan Segar
      </button>
      <button type="button" data-prompt="Rekomendasikan produk olahan tuna yang stoknya tersedia." class="quick-prompt text-xs bg-slate-100 hover:bg-sky-50 text-slate-700 hover:text-ocean border border-slate-200 rounded-full px-3 py-1 transition">
        Rekomendasi Produk Olahan
      </button>
    </div>

    <!-- Input Form -->
    <form id="chatForm" class="flex flex-col sm:flex-row gap-2.5">
      <div class="relative flex-1">
        <input
          id="chatInput"
          type="text"
          maxlength="500"
          autocomplete="off"
          placeholder="Tulis pertanyaan tentang produk TunaFresh..."
          class="w-full border border-slate-300 rounded-xl pl-4 pr-14 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-ocean/20 focus:border-ocean"
        >
        <span id="charCount" class="absolute right-3 top-1/2 -translate-y-1/2 text-[11px] text-slate-400">0/500</span>
      </div>
      <button
        id="chatSendBtn"
        type="submit"
        class="bg-ocean hover:bg-deep text-white font-semibold rounded-xl px-6 py-3 text-sm transition disabled:opacity-50 disabled:cursor-not-allowed shrink-0"
      >
        Kirim
      </button>
    </form>
  </section>

  <!-- Form Tambah / Edit Produk -->
  <section class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
    <div class="flex justify-between items-center mb-5">
      <h2 id="formTitle" class="text-xl font-bold text-deep">Tambah Produk</h2>
      <button id="reset" type="button" class="text-sm text-ocean hover:underline">Reset Form</button>
    </div>
    <form id="form" class="grid md:grid-cols-2 gap-4">
      <input type="hidden" id="id">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Nama produk</label>
        <input id="nama" required class="w-full border border-slate-300 rounded-xl p-2.5 text-sm focus:outline-none focus:border-ocean">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Kategori</label>
        <select id="kategori" required class="w-full border border-slate-300 rounded-xl p-2.5 text-sm focus:outline-none focus:border-ocean">
          <option value="">Pilih kategori</option>
          <option>Ikan Segar</option>
          <option>Produk Olahan</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Harga (Rp)</label>
        <input id="harga" type="number" min="0" required class="w-full border border-slate-300 rounded-xl p-2.5 text-sm focus:outline-none focus:border-ocean">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Satuan</label>
        <input id="satuan" required placeholder="500 gram / kg / pack" class="w-full border border-slate-300 rounded-xl p-2.5 text-sm focus:outline-none focus:border-ocean">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Stok</label>
        <input id="stok" type="number" min="0" step="1" required class="w-full border border-slate-300 rounded-xl p-2.5 text-sm focus:outline-none focus:border-ocean">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">Deskripsi</label>
        <input id="deskripsi" class="w-full border border-slate-300 rounded-xl p-2.5 text-sm focus:outline-none focus:border-ocean">
      </div>
      <div class="md:col-span-2 flex items-center gap-3 pt-1">
        <button id="save" class="bg-ocean hover:bg-deep text-white rounded-xl px-6 py-2.5 text-sm font-semibold transition">Simpan Produk</button>
        <span id="message" class="text-sm"></span>
      </div>
    </form>
  </section>

  <!-- Daftar Produk -->
  <section id="daftar-produk" class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-xl font-bold text-deep">Daftar Produk</h2>
      <button id="refresh" type="button" class="border border-ocean text-ocean hover:bg-sky-50 rounded-xl px-4 py-2 text-sm font-medium transition">Muat Ulang</button>
    </div>
    <p id="tableMessage" class="text-sm text-slate-500 mb-3"></p>
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left">
        <thead class="bg-slate-100 text-slate-700">
          <tr>
            <th class="p-3 rounded-tl-lg">ID</th>
            <th class="p-3">Produk</th>
            <th class="p-3">Kategori</th>
            <th class="p-3">Harga</th>
            <th class="p-3">Satuan</th>
            <th class="p-3">Stok</th>
            <th class="p-3 rounded-tr-lg">Aksi</th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
  </section>
</main>

<script>
const $ = id => document.getElementById(id);
const rows = $('rows'), form = $('form');
const rupiah = n => new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', maximumFractionDigits: 0 }).format(Number(n));

function esc(s) {
  const div = document.createElement('div');
  div.textContent = s ?? '';
  return div.innerHTML;
}

async function request(url, options = {}) {
  const r = await fetch(url, { headers: { 'Content-Type': 'application/json' }, ...options });
  const d = await r.json();
  if (!r.ok) throw Error(d.message || 'Permintaan gagal');
  return d;
}

async function load() {
  rows.innerHTML = '<tr><td colspan="7" class="p-4 text-slate-500">Memuat data...</td></tr>';
  try {
    const d = await request('/api/produk');
    $('total').textContent = d.total;
    $('tableMessage').textContent = d.total + ' produk ditemukan dari database.';
    rows.innerHTML = d.data.length
      ? d.data.map(p => `<tr class="border-b border-slate-100 hover:bg-slate-50/60">
          <td class="p-3">${p.id}</td>
          <td class="p-3"><b>${esc(p.nama)}</b><div class="text-xs text-slate-500">${esc(p.deskripsi)}</div></td>
          <td class="p-3">${esc(p.kategori)}</td>
          <td class="p-3">${rupiah(p.harga)}</td>
          <td class="p-3">${esc(p.satuan)}</td>
          <td class="p-3">${p.stok}</td>
          <td class="p-3 space-x-1 whitespace-nowrap">
            <button data-edit="${p.id}" class="bg-amber-100 hover:bg-amber-200 text-amber-800 rounded-lg px-3 py-1 text-xs font-medium">Edit</button>
            <button data-del="${p.id}" class="bg-red-100 hover:bg-red-200 text-red-700 rounded-lg px-3 py-1 text-xs font-medium">Hapus</button>
          </td>
        </tr>`).join('')
      : '<tr><td colspan="7" class="p-4 text-slate-500">Belum ada produk.</td></tr>';
  } catch (e) {
    rows.innerHTML = `<tr><td colspan="7" class="p-4 text-red-600">${esc(e.message)}</td></tr>`;
  }
}

async function status() {
  try {
    const d = await request('/api/status');
    $('backend').textContent = 'Online';
    $('database').textContent = d.database === 'connected' ? 'Terhubung' : 'Terputus';
    $('backend').className = 'text-lg text-emerald-600 mt-1 block font-bold';
    $('database').className = 'text-lg text-emerald-600 mt-1 block font-bold';
  } catch (e) {
    $('backend').textContent = 'Tidak tersedia';
    $('database').textContent = 'Periksa koneksi';
    $('backend').className = 'text-lg text-red-600 mt-1 block font-bold';
    $('database').className = 'text-lg text-red-600 mt-1 block font-bold';
  }
}

function reset() {
  form.reset();
  $('id').value = '';
  $('formTitle').textContent = 'Tambah Produk';
  $('save').textContent = 'Simpan Produk';
  $('message').textContent = '';
}

$('reset').onclick = reset;
$('refresh').onclick = () => { load(); status(); };

form.onsubmit = async e => {
  e.preventDefault();
  const id = $('id').value;
  const body = {
    nama: $('nama').value.trim(),
    kategori: $('kategori').value,
    harga: Number($('harga').value),
    satuan: $('satuan').value.trim(),
    stok: Number($('stok').value),
    deskripsi: $('deskripsi').value.trim()
  };
  try {
    const d = await request(id ? '/api/produk/' + id : '/api/produk', {
      method: id ? 'PUT' : 'POST',
      body: JSON.stringify(body)
    });
    reset();
    $('message').textContent = d.message;
    $('message').className = 'text-sm text-emerald-700 font-medium';
    await load();
  } catch (err) {
    $('message').textContent = err.message;
    $('message').className = 'text-sm text-red-600 font-medium';
  }
};

rows.onclick = async e => {
  const edit = e.target.closest('[data-edit]'), del = e.target.closest('[data-del]');
  if (edit) {
    try {
      const d = await request('/api/produk/' + edit.dataset.edit), p = d.data;
      $('id').value = p.id;
      $('nama').value = p.nama;
      $('kategori').value = p.kategori;
      $('harga').value = p.harga;
      $('satuan').value = p.satuan;
      $('stok').value = p.stok;
      $('deskripsi').value = p.deskripsi || '';
      $('formTitle').textContent = 'Edit Produk #' + p.id;
      $('save').textContent = 'Simpan Perubahan';
      form.scrollIntoView({ behavior: 'smooth' });
    } catch (err) {
      alert(err.message);
    }
  }
  if (del && confirm('Hapus produk ini?')) {
    try {
      const d = await request('/api/produk/' + del.dataset.del, { method: 'DELETE' });
      alert(d.message);
      await load();
    } catch (err) {
      alert(err.message);
    }
  }
};

// ===== AI Assistant Frontend Logic (Fetch API) =====
const chatMessages = $('chatMessages');
const chatForm = $('chatForm');
const chatInput = $('chatInput');
const chatSendBtn = $('chatSendBtn');
const charCount = $('charCount');

chatInput.addEventListener('input', () => {
  charCount.textContent = `${chatInput.value.length}/500`;
});

function addChatBubble(role, text, isError = false) {
  const row = document.createElement('div');
  if (role === 'user') {
    row.className = 'flex items-start justify-end gap-2.5';
    row.innerHTML = `<div class="bg-ocean text-white rounded-2xl rounded-tr-sm px-4 py-2.5 text-sm shadow-sm max-w-[85%] whitespace-pre-line">${esc(text)}</div>`;
  } else {
    row.className = 'flex items-start gap-2.5';
    const boxStyle = isError
      ? 'bg-red-50 border-red-200 text-red-700'
      : 'bg-white border-slate-200 text-slate-700';
    row.innerHTML = `
      <div class="w-7 h-7 rounded-full ${isError ? 'bg-red-600' : 'bg-ocean'} text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">AI</div>
      <div class="${boxStyle} border rounded-2xl rounded-tl-sm px-4 py-2.5 text-sm shadow-sm max-w-[85%] whitespace-pre-line">${esc(text)}</div>
    `;
  }
  chatMessages.appendChild(row);
  chatMessages.scrollTop = chatMessages.scrollHeight;
  return row;
}

async function handleSendChat(messageText) {
  const trimmed = messageText.trim();
  if (!trimmed) {
    addChatBubble('ai', 'Pesan tidak boleh kosong. Silakan ketik pertanyaan Anda.', true);
    return;
  }

  addChatBubble('user', trimmed);
  chatInput.value = '';
  charCount.textContent = '0/500';
  chatInput.disabled = true;
  chatSendBtn.disabled = true;

  const loadingRow = document.createElement('div');
  loadingRow.className = 'flex items-start gap-2.5';
  loadingRow.innerHTML = `
    <div class="w-7 h-7 rounded-full bg-ocean text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">AI</div>
    <div class="bg-white border border-slate-200 rounded-2xl rounded-tl-sm px-4 py-2.5 text-sm text-slate-400 italic shadow-sm flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-ocean animate-bounce"></span>
      <span>AI sedang memproses jawaban...</span>
    </div>
  `;
  chatMessages.appendChild(loadingRow);
  chatMessages.scrollTop = chatMessages.scrollHeight;

  try {
    const res = await fetch('/api/chat', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: trimmed })
    });
    const data = await res.json();
    loadingRow.remove();

    if (res.ok && data.success) {
      addChatBubble('ai', data.data.reply);
    } else {
      addChatBubble('ai', data.message || 'Gagal memperoleh respons dari AI Assistant.', true);
    }
  } catch (err) {
    loadingRow.remove();
    addChatBubble('ai', 'Tidak dapat terhubung ke server. Pastikan server Express berjalan.', true);
  } finally {
    chatInput.disabled = false;
    chatSendBtn.disabled = false;
    chatInput.focus();
  }
}

chatForm.addEventListener('submit', e => {
  e.preventDefault();
  handleSendChat(chatInput.value);
});

document.querySelectorAll('.quick-prompt').forEach(btn => {
  btn.addEventListener('click', () => handleSendChat(btn.dataset.prompt));
});

$('clearChat').addEventListener('click', () => {
  chatMessages.innerHTML = `
    <div class="flex items-start gap-2.5">
      <div class="w-7 h-7 rounded-full bg-ocean text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">AI</div>
      <div class="bg-white border border-slate-200 rounded-2xl rounded-tl-sm px-4 py-2.5 text-sm text-slate-700 shadow-sm max-w-[85%]">
        Halo! Saya <b>TunaFresh AI Assistant</b>. Silakan tanyakan informasi seputar produk ikan tuna segar maupun olahan yang tersedia di aplikasi ini.
      </div>
    </div>
  `;
});

load();
status();
</script>

<%- include('partials/footer') %>